# ===== 服务端口 =====
# 后端监听端口
BACKEND_PORT=3000

# 前端监听端口
FRONTEND_PORT=5173

# ===== 数据库（Phase 0 引入） =====
# SQLite 数据库文件路径（Prisma 相对于 backend/prisma/schema.prisma 所在目录解析）
# file:../dev.db => backend/dev.db
DATABASE_URL=file:../dev.db

# ===== 认证（Phase 1 使用） =====
# JWT 签名密钥，生产环境必须替换为强随机值，禁止提交真实值
JWT_SECRET=dev-secret-change-me

# ===== LLM 服务（Phase 4 使用） =====
# OpenAI 兼容接口地址，例如 https://api.openai.com/v1
LLM_BASE_URL=
# 使用的模型名称，例如 gpt-4o-mini
LLM_MODEL=
# LLM API Key，仅从环境变量读取，禁止硬编码
LLM_API_KEY=
